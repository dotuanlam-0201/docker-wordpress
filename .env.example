
# ==========================================
# DATABASE
# ==========================================
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wordpress_user
MYSQL_PASSWORD=change_me_db_password

# ==========================================
# WORDPRESS
# ==========================================
WORDPRESS_PORT=8080
WORDPRESS_URL=http://localhost:8080
WORDPRESS_TITLE=My WordPress Site
WORDPRESS_ADMIN_USERNAME=admin
WORDPRESS_ADMIN_PASSWORD=change_me_admin_password
WORDPRESS_ADMIN_EMAIL=admin@example.com

# ==========================================
# GENERAL SETTINGS
# ==========================================
WORDPRESS_ENVIRONMENT=development
WORDPRESS_DEBUG=false
WORDPRESS_DEBUG_LOG=false
WORDPRESS_DEBUG_DISPLAY=false
WORDPRESS_LOCALE=en_US
WORDPRESS_TIMEZONE=UTC

# ==========================================
# SMTP / EMAIL
# ==========================================
SMTP_ENABLED=false
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=WordPress Website
SMTP_AUTH=true

# ==========================================
# SECURITY
# ==========================================
WORDPRESS_FORCE_SSL=false
WORDPRESS_DISABLE_FILE_EDIT=true
WORDPRESS_DISALLOW_FILE_MODS=false
WORDPRESS_AUTO_UPDATES=true

# ==========================================
# PHP
# ==========================================
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_VARS=3000

# ==========================================
# PLUGINS
# ==========================================
PLUGIN_WP_MAIL_SMTP=true
PLUGIN_WORDFENCE=true
PLUGIN_RANK_MATH=true
PLUGIN_LITESPEED_CACHE=false
PLUGIN_UPDRAFTPLUS=true

# ==========================================
# DOCKER
# ==========================================
COMPOSE_PROJECT_NAME=wordpress
TZ=UTC
